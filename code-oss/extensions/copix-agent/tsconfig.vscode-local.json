{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vscode"],
    "noEmit": true
  },
  "include": [
    "src/extension.ts",
    "src/chatView.ts",
    "src/diffView.ts",
    "src/editorGuard.ts"
  ]
}
